---
import "../styles/global.css";
import { profile, cases, about } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  namespace: "home" | "work" | "single";
  /** extra JSON-LD nodes for this page, added to the site-wide Person and WebSite */
  schema?: Record<string, unknown>[];
}

const { title, description = profile.description, namespace, schema = [] } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Software Engineer in Lalitpur, Nepal`;
const path = Astro.url.pathname;
const site = Astro.site!.origin;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

/* Structured data: tells search engines who this site is about, so a search for the name
   can show this site (and its LinkedIn link) as the person's official page. */
const personId = `${site}/#person`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: profile.name,
      givenName: "Rupesh",
      familyName: "Bhandari",
      url: `${site}/`,
      image: ogImage,
      jobTitle: about.experience[0].role,
      worksFor: { "@type": "Organization", name: about.experience[0].org },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Kantipur City College" },
      email: `mailto:${profile.email}`,
      address: { "@type": "PostalAddress", addressLocality: "Lalitpur", addressCountry: "NP" },
      knowsAbout: ["React Native", "Next.js", "Laravel", "TypeScript", "Mobile App Development", "AI data products", "WebSockets"],
      sameAs: [profile.linkedin],
      description: profile.description,
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: profile.name,
      alternateName: ["Rupesh Bhandari Portfolio", "bhandarirupesh.com.np"],
      author: { "@id": personId },
      inLanguage: "en",
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f5f1" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={namespace === "home" ? "profile" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, software engineer in Lalitpur, Nepal`} />
    {namespace === "home" && <meta property="profile:first_name" content="Rupesh" />}
    {namespace === "home" && <meta property="profile:last_name" content="Bhandari" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP:wght@400;700&family=Righteous&display=swap" rel="stylesheet" />
    <script is:inline>history.scrollRestoration = "manual";</script>
  </head>
  <body data-barba="wrapper" class="l-wrapper">
    <header class="l-header">
      <div class="l-header__inner">
        <div class="l-header__texts u-en">
          <a class="l-header__logo" href="/">{profile.logo}</a>
          <p class="l-header__text">{profile.disciplines.map((d, i) => <Fragment>{d}{i < profile.disciplines.length - 1 && <br />}</Fragment>)}</p>
        </div>
        <button class="l-header__menu-button" type="button" aria-label="Open menu" aria-controls="header-menu" aria-expanded="false">
          <span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span>
        </button>
        <div class="l-header__menu" id="header-menu" inert>
          <nav class="l-header__menu-nav u-en" aria-label="Main menu">
            <ul class="l-header__ul">
              <li class="l-header__li"><a href="/">Home</a></li>
              <li class="l-header__li"><a href="/work/about/">About</a></li>
            </ul>
            <ul class="l-header__ul l-header__ul--case">
              <li class="l-header__li-title">Work</li>
              {cases.map((c) => <li class="l-header__li"><a href={`/work/${c.slug}/`}>{c.label}</a></li>)}
            </ul>
            <ul class="l-header__ul">
              <li class="l-header__li"><a href="/work/?case=contact">Contact</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <div data-barba="container" data-barba-namespace={namespace}>
      <main class="l-main" tabindex="-1">
        <slot />
      </main>
    </div>

    <p class="u-sr" data-route-announcer role="status" aria-live="polite"></p>
    <div class="l-transition" data-transition aria-hidden="true"></div>
    <div class="c-toast" data-toast role="status"></div>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>

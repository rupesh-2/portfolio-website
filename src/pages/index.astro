---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import { profile } from "../data/site";
const ring = "Click me! Welcome to my room. ";
---

<Layout namespace="home">
  <div class="p-index">
    <h1 class="u-sr">{profile.name}, software engineer</h1>

    <div class="p-home-loading" role="status" aria-label="Loading">
      <div class="p-home-loading__filter" aria-hidden="true"></div>
      <div class="p-home-loading__contents u-en">
        <div class="p-home-loading__cover">
          <p class="p-home-loading__text">Don’t be shy.<br />Feel free to say</p>
          <p class="p-home-loading__title">“Namaste!”</p>
        </div>
        <svg class="p-home-loading__circle" viewBox="0 0 340 340" aria-hidden="true">
          <defs><path id="ring" d="M170,170 m-150,0 a150,150 0 1,1 300,0 a150,150 0 1,1 -300,0" /></defs>
          <text data-ring><textPath href="#ring">{ring}{ring}</textPath></text>
        </svg>
      </div>
    </div>

    <div class="p-home">
      <div class="p-home__stage">
        <div class="p-home__scene" data-scene role="button" tabindex="0" aria-label="Say hi to Rupesh and open his profile"></div>
      </div>

      <div class="p-home__side" inert>
        <div>
          <div class="p-home__side-head">
            <p class="p-home__side-hey u-en">Hey! 🤝</p>
            <p class="p-home__side-en u-en">I’m Rupesh,<br />a software engineer<br />from Lalitpur, Nepal.</p>
          </div>
          <p class="p-home__side-body">
            I build production web and mobile apps with React Native, Next.js and Laravel, and right now I’m building AI-driven
            data products at Inseed: an art valuation platform and a private memoir app.
          </p>
          <p class="p-home__side-body">
            Before that I shipped a municipal service platform for local government, a PWA on the Google Play Store and real-time
            systems on WebSockets. I like owning a feature end to end, from the data and API to the screen and the release.
          </p>
          <div class="p-home__side-sticker" data-sticker aria-hidden="true">
            <svg viewBox="0 0 220 120" width="220" height="120">
              <g class="sticker-badge">
                <rect x="6" y="18" width="208" height="84" rx="42" fill="#3c3728" />
                <text x="110" y="70" text-anchor="middle" fill="#f7f5f1" font-family="Righteous, sans-serif" font-size="30">ship it today</text>
              </g>
              <circle class="sticker-dot" cx="196" cy="24" r="14" fill="#fea831" />
            </svg>
          </div>
        </div>
        <div class="p-home__side-link u-en">
          <a href="/work/" class="c-rollhost">
            <span class="c-roll">
              <span class="c-roll__text">Get to know me</span>
              <span class="c-roll__text c-roll__text--clone" aria-hidden="true">Get to know me</span>
            </span>
            <Arrow />
          </a>
        </div>
      </div>

      <div class="c-stalker c-stalker--big u-en" data-stalker aria-hidden="true">Hey!</div>
    </div>
  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Slide from "../../components/Slide.astro";
import Marquee from "../../components/Marquee.astro";
import Arrow from "../../components/Arrow.astro";
import { profile, cases, about } from "../../data/site";

const slides = [
  { id: "about", nav: "About", marquee: about.marquee },
  ...cases.map((c) => ({ id: c.slug, nav: c.label, marquee: c.marquee })),
  { id: "contact", nav: "Contact", marquee: "Don’t be shy. Feel free to say Namaste! Open to engineering roles and freelance work." },
];
---

<Layout namespace="work" title="Work">
  <div class="p-case">
    <h1 class="u-sr">Work</h1>
    <div class="p-work" data-pager>
      {slides.map((s) => <Marquee id={s.id} text={s.marquee} />)}

      <Slide id="about" title="About" href="/work/about/" text={about.short} icon="me" />
      {cases.map((c) => <Slide id={c.slug} title={c.label.replace(" ", "")} href={`/work/${c.slug}/`} text={c.short} icon={c.icon} tags={c.tags} />)}

      <div class="p-work__slide" data-list="contact" id="contact">
        <div class="p-work__item p-work__item--contact">
          <h2 class="p-work__title u-en"><span>Say “Namaste!”</span></h2>
          <p class="p-work__sub u-en">Drop me a message, okay?</p>
          <form class="c-contact" data-contact novalidate>
            <div class="c-contact__row">
              <label class="c-contact__field">
                <span>Name</span>
                <input name="name" type="text" autocomplete="name" maxlength="80" required />
              </label>
              <label class="c-contact__field">
                <span>Email</span>
                <input name="email" type="email" autocomplete="email" maxlength="254" required />
              </label>
            </div>
            <label class="c-contact__field">
              <span>Message</span>
              <textarea name="message" rows="4" maxlength="5000" required></textarea>
            </label>
            <!-- honeypot: deliberately not a name browsers autofill -->
            <label class="c-contact__hp" aria-hidden="true">
              Leave empty <input name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </label>
            <div class="c-contact__foot">
              <p class="c-contact__status" data-contact-status role="status"></p>
              <button type="submit" class="c-contact__send u-en">Send</button>
            </div>
          </form>
          <div class="p-work__contacts">
            <button type="button" data-copy={profile.email}>{profile.email}</button>
            <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href={profile.whatsapp} target="_blank" rel="noopener">WhatsApp ↗</a>
          </div>
        </div>
      </div>

      <nav class="p-work__nav" aria-label="Sections">
        <ul>
          {slides.map((s) => <li><button class="u-en" type="button" data-nav={s.id}><span class="label">{s.nav}</span><span class="dot" aria-hidden="true"></span></button></li>)}
        </ul>
      </nav>

      <div class="c-stalker u-en" data-stalker aria-hidden="true">View more <Arrow small color="#F7F5F1" /></div>
      <p class="c-copyright u-en">©rupesh bhandari</p>
    </div>
  </div>
</Layout>
